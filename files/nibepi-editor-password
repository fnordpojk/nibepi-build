#!/bin/bash
# Gives NibePi's Node-RED editor a password of its own. Runs once, on the
# first boot. Run it again for a new password, then restart NibePi:
#   sudo nibepi-editor-password && sudo systemctl restart nibepi
set -euo pipefail

dir=/etc/nibepi-node-red
node_red=/opt/nibepi/data/nibepi-flow/node_modules/node-red

[ "$(id -u)" = 0 ] || { echo "Run it with sudo: sudo nibepi-editor-password" >&2; exit 1; }

# 16 characters from A-Z, a-z, 0-9, - and _.
password=$(node -e "process.stdout.write(require('crypto').randomBytes(12).toString('base64url'))")
# Hashed with the bcrypt that Node-RED itself uses.
pw_hash=$(PASSWORD=$password node -e "
const bcrypt = require(require.resolve('bcryptjs', {paths: ['$node_red']}));
process.stdout.write(bcrypt.hashSync(process.env.PASSWORD, 10));")

umask 077
printf '%s\n' "$password" > "$dir/editor-password"
# Node-RED reads the hash as the nibepi user. It is written last, since its
# presence tells systemd that the password exists.
printf '%s\n' "$pw_hash" > "$dir/editor-password.hash.new"
chmod 644 "$dir/editor-password.hash.new"
mv "$dir/editor-password.hash.new" "$dir/editor-password.hash"
echo "The Node-RED editor's user is admin. Its password is in $dir/editor-password."
